<?xml version="1.0"?>
<hivemq>

    <control-center>
        <enabled>true</enabled>
        <listeners>
            <http>
                <port>8080</port>
                <bind-address>localhost</bind-address>
            </http>
            <https>
                <port>8443</port>
                <bind-address>0.0.0.0</bind-address>
                <tls>
                    <keystore>
                        <path>conf/examples/configuration/tls/keystore.jks</path>
                        <password>password</password>
                        <private-key-password>pkpassword</private-key-password>
                    </keystore>
                    <truststore>
                        <path>conf/examples/configuration/tls/truststore.jks</path>
                        <password>password</password>
                    </truststore>
                </tls>
            </https>
        </listeners>
    </control-center>

</hivemq>
