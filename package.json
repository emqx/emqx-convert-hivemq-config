{
  "name": "hivemq-to-emqx-converter",
  "version": "1.0.0",
  "description": "Convert HiveMQ XML configuration to EMQX HOCON format",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "pages:deploy": "wrangler pages deploy dist",
    "pages:dev": "wrangler pages dev dist",
    "type-check": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "convert": "pnpm run build && pnpm run cli"
  },
  "bin": {
    "hivemq-convert": "dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wrangler": "^4.43.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.2"
  }
}