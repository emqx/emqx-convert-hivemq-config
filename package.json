{
  "name": "hivemq-to-emqx-converter",
  "version": "1.1.0",
  "description": "Convert HiveMQ XML configuration to EMQX 6.3.2 HOCON",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node dist/server.js",
    "start": "node dist/server.js",
    "build": "node scripts/clean-dist.mjs && tsc",
    "type-check": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "convert": "pnpm run build && node dist/cli.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:emqx": "pnpm run build && node --test test/integration/*.test.mjs && bash scripts/test-emqx-suite.sh",
    "test:emqx:config": "pnpm run build && bash scripts/test-emqx.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm run build"
  },
  "bin": {
    "hivemq-convert": "dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emqx/emqx-convert-hivemq-config.git"
  },
  "bugs": "https://github.com/emqx/emqx-convert-hivemq-config/issues",
  "homepage": "https://github.com/emqx/emqx-convert-hivemq-config#readme",
  "exports": {
    ".": "./dist/conversion-service.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
